# Copy this file to .env and fill in your values.
# CalDAV accounts (Nextcloud, Baikal, etc.) need no .env configuration — they are
# set up per-user in Settings → Calendar.

# ── Microsoft Calendar ─────────────────────────────────────────────────────────
# Register at https://portal.azure.com → Entra ID → App registrations
#   Supported account types: Accounts in any organizational directory + personal Microsoft accounts
#   Platform:               Mobile and desktop applications
#   Redirect URI:           http://localhost  (exact port varies at runtime — use localhost without port)
#   API permissions:        User.Read (delegated), Calendars.Read (delegated), offline_access

AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_TENANT_ID=common

# ── Google Calendar ────────────────────────────────────────────────────────────
# Register at https://console.cloud.google.com → APIs & Services → Credentials
#   Create credentials: OAuth client ID → Desktop app
#   Enable API:         Google Calendar API
#   Scopes:             https://www.googleapis.com/auth/calendar.readonly
# Note: client_secret is required for Desktop app type (it is not sensitive for installed apps)

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── Zoom ───────────────────────────────────────────────────────────────────────
# Register at https://marketplace.zoom.us/develop/create → General App (OAuth)
#   Redirect URL for OAuth: http://localhost  (exact port varies at runtime)
#   Scopes:                 meeting:read:list_meetings, user:read:user

ZOOM_CLIENT_ID=your-zoom-client-id-here
ZOOM_CLIENT_SECRET=your-zoom-client-secret-here
