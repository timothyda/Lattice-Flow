# Opus Flo Server — copy this file to .env and edit before first run

# Port the server listens on (default: 3847)
PORT=3847

# Path to the SQLite database file
# Use an absolute path to pin it to a specific location on your NAS.
# DB_PATH=C:\OpusFlo\data\opus-flo.db
DB_PATH=./data/opus-flo.db

# Secret used to sign JWT tokens — CHANGE THIS before production use!
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# SMTP settings for email notifications (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=noreply@yourcompany.com
