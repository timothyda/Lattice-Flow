# Opus Flo Server — nginx reverse proxy config (Option B: Cloud VPS with HTTPS)
#
# Replace YOUR_DOMAIN with your actual domain (e.g. yourteam.yourdomain.com)
#
# Install:
#   sudo cp nginx.conf.example /etc/nginx/sites-available/opus-flo
#   sudo nano /etc/nginx/sites-available/opus-flo   # set YOUR_DOMAIN
#   sudo ln -s /etc/nginx/sites-available/opus-flo /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d YOUR_DOMAIN

server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;

    # Managed by certbot
    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass         http://localhost:3847;
        proxy_http_version 1.1;

        # Required for WebSocket (real-time updates)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
    }
}
